# =====================================================================
# AIOD Environment Configuration Template
# Copy this file to .env and configure your local settings:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows PowerShell/cmd)
# =====================================================================

# Google Gemini API Key (Optional: for AI Multimodal Scene Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
AIOD_DB_HOST=localhost
AIOD_DB_PORT=3306
AIOD_DB_USER=root
AIOD_DB_PASSWORD=your_mysql_password_here
AIOD_DB_NAME=object_detection_db

# Detection Hyperparameters
AIOD_CONFIDENCE=0.25
AIOD_IOU=0.45

# Device Selection: leave empty for auto-detection (CUDA if available, else CPU), or set 'cpu' / 'cuda'
AIOD_DEVICE=

# Database Fallback: automatically use local SQLite if MySQL is unavailable
AIOD_SQLITE_FALLBACK=true

